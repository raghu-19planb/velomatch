{
  "_schema": {
    "note": "Canonical catalog for the kids' first-bike quiz (index.html). Edit this file directly and push — Netlify redeploys automatically. Optional live override: set SHEET_CSV_URL in index.html to a published Google Sheet CSV with the same column names; when set, it replaces this file's data at load time without a redeploy.",
    "fields": {
      "name": "string — model name shown to users",
      "brand": "string",
      "origin": "string — country of the brand, used for the 'prefer Canadian' filter",
      "wheel": "number — wheel diameter in inches (16 or 20 typically)",
      "minH": "number — cm, lower bound of the height this bike fits",
      "maxH": "number — cm, upper bound of the height this bike fits",
      "price": "number — face-value price in whatever 'currency' says (see below); the budget slider compares this number as-is and does not convert between currencies",
      "currency": "optional string, 3-letter code (e.g. 'CAD') — omit to mean USD, the default for every entry added before this field existed",
      "brake": "'coaster' | 'hand'",
      "type": "'pavement' | 'road_gravel' | 'park' | 'trail_road_gravel' | 'trail' — best-fit terrain, scored by proximity",
      "exp": "array of 'none' | 'balance' | 'training' | 'confident' — rider experience levels this bike suits",
      "seatRange": "number — cm of seatpost height adjustment, used to estimate years of growth",
      "barAdjust": "boolean — handlebar height/reach is adjustable",
      "trainWheel": "boolean — compatible with training wheels",
      "resale": "'low' | 'medium' | 'high' — informational only, not currently scored",
      "image": "string — relative path (e.g. images/kids/cleary-gecko.jpg) or full URL to a product photo; leave empty to show the sketch placeholder",
      "retailerUrl": "optional string — a specific product page URL, set ONLY when a human has actually opened that exact URL and confirmed it shows this bike (e.g. a page the user shared). Never guessed or constructed. When absent, the result card links to a live web search for the bike's name instead of a specific (possibly wrong or dead) product page — price/stock are the least stable part of any catalog entry, so we point to a live source rather than caching a number that will go stale."
    }
  },
