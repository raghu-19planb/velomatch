{
  "_schema": {
    "note": "Canonical catalog for the commuting quiz (commute.html). Edit this file directly and push — Netlify redeploys automatically. Optional live override: set SHEET_CSV_URL in commute.html to a published Google Sheet CSV with the same column names. Specs are researched from real current/recent models but are NOT live-verified against manufacturer spec sheets — treat as a well-informed prototype catalog, not a scraped, guaranteed-current source. An entry may carry an optional '_verified' field noting exactly which fields were confirmed against a live source, when, and where — absence of that field means the whole entry is knowledge-based, not scraped. See DATA.md for the catalog's scope and how to grow it responsibly.",
    "fields": {
      "name": "string — model name shown to users",
      "brand": "string",
      "origin": "string — country of the brand, used for the 'prefer Canadian' filter",
      "wheel": "number — wheel diameter in mm (700 road/hybrid, 650/660 smaller hybrid, 406 folding ~20in)",
      "minH": "number — cm, lower bound of rider height this bike fits",
      "maxH": "number — cm, upper bound of rider height this bike fits",
      "price": "number — face-value price in whatever 'currency' says; the budget slider compares this number as-is and does not convert between currencies",
      "currency": "optional string, 3-letter code (e.g. 'CAD') — omit to mean USD, the default for every entry added before this field existed",
      "gearing": "'single' | 'internal' | 'derailleur' — drivetrain structure",
      "type": "'city_streets' | 'mixed_paths' | 'long_flat' | 'hilly_assist' — best-fit route, scored by proximity",
      "powerType": "'pedal' | 'ebike'",
      "cargoCapacity": "number 0-3 — 0 none, 1 rack-ready, 2 rack+panniers, 3 heavy-duty cargo",
      "weight": "number — kg, used to score portability/storage importance",
      "foldable": "boolean — true only for actual folding-frame bikes; weighted heavily for portability since folding matters more than a kg or two of weight",
      "maxComfortDistance": "number — km, comfortable one-way commute distance",
      "frameMaterial": "'aluminum' | 'steel' | 'carbon'",
      "groupset": "string — the actual drivetrain/hub name shown to users; matched against the groupset-preference question by manufacturer keyword or by gearing==='internal' for 'low-maintenance'",
      "colors": "array of strings — color options this model actually ships in",
      "ridingPosition": "'upright' | 'relaxed' | 'sporty' — how far forward you lean; translates handlebar/geometry style into a plain-language question",
      "fendersIncluded": "boolean — ships with fenders/mudguards standard (not just fender mounts)",
      "brakeType": "'rim' | 'disc'",
      "tireProfile": "'standard' | 'wide' — wide covers gravel/adventure and semi-fat e-bike tires, matched against the flat-tire-worry question",
      "suspensionFork": "boolean — has a front suspension fork for rough pavement/potholes",
      "image": "string — relative path (e.g. images/commute/trek-fx2.jpg) or full URL to a product photo; leave empty to show the sketch placeholder",
      "retailerUrl": "optional string — a specific product page URL, set ONLY when a human has actually opened that exact URL and confirmed it shows this bike (e.g. a page the user shared). Never guessed or constructed. When absent, the result card links to a live web search for the bike's name instead of a specific (possibly wrong or dead) product page — price/stock are the least stable part of any catalog entry, so we point to a live source rather than caching a number that will go stale."
    }
  },
