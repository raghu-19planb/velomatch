{
  "_schema": {
    "note": "Canonical catalog for the commuting quiz (commute.html). Edit this file directly and push — Netlify redeploys automatically. Optional live override: set SHEET_CSV_URL in commute.html to a published Google Sheet CSV with the same column names.",
    "fields": {
      "name": "string — model name shown to users",
      "brand": "string",
      "origin": "string — country of the brand, used for the 'prefer Canadian' filter",
      "wheel": "number — wheel diameter in mm (700 road/hybrid, 650 smaller hybrid, 406 folding ~20in)",
      "minH": "number — cm, lower bound of rider height this bike fits",
      "maxH": "number — cm, upper bound of rider height this bike fits",
      "price": "number — USD",
      "gearing": "'single' | 'internal' | 'derailleur' — drivetrain structure",
      "type": "'city_streets' | 'mixed_paths' | 'long_flat' | 'hilly_assist' — best-fit route, scored by proximity",
      "powerType": "'pedal' | 'ebike'",
      "cargoCapacity": "number 0-3 — 0 none, 1 rack-ready, 2 rack+panniers, 3 heavy-duty cargo",
      "weight": "number — kg, used to score portability/storage importance",
      "foldable": "boolean — true only for actual folding-frame bikes (Brompton, Tern); weighted heavily for portability since folding matters more than a kg or two of weight for stairs/storage/transit",
      "maxComfortDistance": "number — km, comfortable one-way commute distance",
      "frameMaterial": "'aluminum' | 'steel' | 'carbon'",
      "groupset": "string — the actual drivetrain/hub name shown to users (e.g. 'Shimano Altus', 'Enviolo CVT'); matched against the groupset-preference question by manufacturer keyword (Shimano / SRAM) or by gearing==='internal' for the 'low-maintenance' option",
      "colors": "array of strings — color options this model actually ships in; matched against the color-preference question",
      "image": "string — relative path (e.g. images/commute/trek-fx2.jpg) or full URL to a product photo; leave empty to show the sketch placeholder"
    }
  },
