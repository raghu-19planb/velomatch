{
  "_schema": {
    "note": "Canonical catalog for the bikepacking quiz (bikepacking.html). Edit this file directly and push — Netlify redeploys automatically. Optional live override: set SHEET_CSV_URL in bikepacking.html to a published Google Sheet CSV with the same column names. Specs are researched from real current/recent models (grounded in bikepacking.com's own route/bike taxonomy plus general domain knowledge) but are NOT live-verified against manufacturer spec sheets. See DATA.md for the catalog's scope.",
    "fields": {
      "name": "string — model name shown to users",
      "brand": "string",
      "origin": "string — country of the brand, used for the 'prefer Canadian' filter",
      "wheel": "number — 700 (700c) or 650 (650b); 650b trades top-end speed for higher-volume tires on rough terrain",
      "sizes": "array of numbers — the actual frame sizes (cm) this model is offered in. The quiz asks riders their known frame size first (how experienced cyclists actually shop) and scores against this list; height is only a fallback for riders who don't know their size.",
      "minH": "number — cm, fallback height range lower bound (used only when the rider picks 'use my height instead')",
      "maxH": "number — cm, fallback height range upper bound",
      "price": "number — face-value price in whatever 'currency' says",
      "currency": "optional string, 3-letter code — omit to mean USD",
      "availability": "'mainstream' | 'boutique' — mainstream: sold through a normal dealer network or large direct-to-consumer brand, realistically walk-in-or-order-online buyable. boutique: small-batch/builder brands, limited distribution. Scoring favors mainstream by default (most people asking 'which bike should I buy' want something they can actually buy without hunting) — boutique bikes still show up when they're genuinely the best fit, or when the rider says they're open to them.",
      "frameMaterial": "'aluminum' | 'steel' | 'titanium' | 'carbon' — steel and titanium show up far more here than in the commute catalog: repairability and ride quality matter more on multi-week remote trips",
      "groupset": "string — the actual drivetrain name shown to users",
      "terrain": "'road_paved' | 'gravel' | 'mixed' | 'trail_mountain' — best-fit terrain, scored by proximity on that spectrum (paved -> gravel -> mixed -> singletrack/technical)",
      "purpose": "'touring' | 'adventure' | 'ultra_race' — touring: loaded, comfort-first, multi-week capable. adventure: the flexible middle ground, most bikepacking trips. ultra_race: minimalist, weight-and-speed-first, self-supported racing (Tour Divide, Trans Am, TCR-style)",
      "cargoCapacity": "number 0-3 — how much gear this bike's realistic setup can carry: 0 ultralight/overnight only, 1 weekend, 2 week-long, 3 multi-week/expedition",
      "rackMounts": "boolean — has real fork/rear rack mounts for a traditional rack + panniers setup",
      "frameBagFriendly": "boolean — main triangle shape/mounts suit a frame bag well",
      "climbingRange": "'standard' | 'low' | 'ultra_low' — lowest available gear, since loaded climbing on steep terrain needs much lower gearing than a fast unloaded ride",
      "suspensionFork": "boolean",
      "dynamoReady": "boolean — commonly built/speced with a dynamo hub for lights/device charging on long or remote trips",
      "weight": "number — kg, unloaded",
      "colors": "array of strings",
      "image": "string — relative path or full URL; leave empty to show the sketch placeholder",
      "retailerUrl": "optional string — set ONLY when a human has actually opened that exact URL and confirmed it shows this bike. Absent means the result card links to a live search instead.",
      "electronicShifting": "boolean — true for genuine Di2/AXS wireless-or-wired electronic shifting, false for mechanical cable-actuated",
      "comfortDamping": "boolean — true for a traditional suspension fork OR a proprietary front-end comfort mechanism (Specialized Future Shock, Cannondale Kingpin pivot); broader than suspensionFork alone since several real comfort systems aren't a telescoping fork",
      "tireDurability": "'standard' | 'reinforced' — reinforced means realistically speced with tougher, more puncture-resistant tubeless gravel/adventure tires"
    }
  },
