{
  "_schema": {
    "note": "Canonical catalog for the racing quiz (racing.html). Edit this file directly and push — GitHub Pages redeploys automatically. Optional live override: set SHEET_CSV_URL in racing.html to a published Google Sheet CSV with the same column names. Specs are researched from real current/recent models but are NOT live-verified against manufacturer spec sheets — treat as a well-informed prototype catalog. Scope (per explicit user decision): road racing + ultra-endurance road cycling (triathlon/Ironman, audax/randonneuring like LEL and PBP, and competitive ultra-distance racing like Race Across America). Trail/mountain-bike racing and dedicated gravel racing are deliberately out of scope — trail racing is planned as its own future category (different bike family entirely: suspension, MTB geometry), and gravel racing overlaps enough with the existing bikepacking catalog to fold in there instead.",
    "fields": {
      "name": "string — model name shown to users",
      "brand": "string",
      "origin": "string — country of the brand, used for the 'prefer Canadian' filter (Cervélo is a real Canadian brand — a nice fit here)",
      "sizes": "array of numbers — real frame sizes (cm) this model ships in. Asked directly first (how serious cyclists actually shop); height is only a fallback.",
      "minH": "number — cm, fallback height range lower bound",
      "maxH": "number — cm, fallback height range upper bound",
      "price": "number — face value in whatever 'currency' says",
      "currency": "optional string, 3-letter code — omit to mean USD",
      "availability": "'mainstream' | 'boutique' — mainstream: normal dealer network. boutique: smaller/premium, limited distribution (e.g. Pinarello, Colnago, Mason). Scoring favors mainstream by default unless the rider says they're open to boutique.",
      "frameMaterial": "'carbon' | 'aluminum' | 'steel' | 'titanium' — steel/titanium show up mainly among audax/randonneur bikes, where ride comfort and repairability over huge distances matter more than raw weight",
      "groupset": "string — the actual drivetrain name shown to users",
      "electronicShifting": "boolean — Di2/AXS/EPS electronic vs mechanical cable-actuated",
      "brakeType": "'disc' | 'rim'",
      "discipline": "'road_race' | 'triathlon' | 'audax' — the primary event/use case this bike is built for. Ultra-distance racing (Race Across America style) is NOT a separate bike pool — it's scored as a strong match against aero road_race bikes and triathlon bikes, and a weak match against audax bikes, since ultra racing is genuinely fast/competitive while audax (LEL, PBP) is deliberately non-competitive endurance riding on similar-looking distances. That distinction is scored explicitly, not treated as interchangeable.",
      "character": "'aero' | 'climbing' | 'all_rounder' | 'endurance' — every bike gets one regardless of discipline (triathlon bikes are always 'aero' by definition, audax bikes are always 'endurance'), but the character QUESTION is only asked when discipline is road_race, since that's the one case where it's a genuine open choice",
      "wheelDepth": "'shallow' | 'deep' — deep-section aero wheels vs lighter shallow climbing wheels",
      "dynamoReady": "boolean — commonly built/speced with mounts or hub for dynamo lighting, relevant for all-night audax/ultra-distance riding",
      "weight": "number — kg, unloaded",
      "colors": "array of strings",
      "image": "string — relative path or full URL; leave empty to show the sketch placeholder",
      "retailerUrl": "optional string — set ONLY when a human has actually opened that exact URL and confirmed it shows this bike. Absent means the result card links to a live search instead."
    }
  },
